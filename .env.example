# ==============================================================================
# ATTENDANCE AI PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in your respective backend/frontend environments.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Server & Networking
NODE_ENV=development
PORT=3041
HOST=0.0.0.0
APP_URL=http://localhost:3042
API_URL=http://localhost:3041
CORS_ORIGIN=http://localhost:3042

# Database Configuration (Isolated PostgreSQL database)
# Production example: postgresql://attendance_user:STRONG_PASSWORD_HERE@127.0.0.1:5432/attendance_ai_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_ai_db?schema=public

# Redis Configuration (Cache, Rate-limiting, Pub/Sub, Queue workers)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT & Authentication Security (Generate 64+ char random strings for production)
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# File Storage Abstraction
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=25

# Email & Notifications (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="Attendance AI System"

# AI Intelligence & Vector Search
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Speech Recognition (STT) & Speech Synthesis (TTS)
STT_PROVIDER=whisper
STT_API_KEY=your_stt_key_here
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_tts_key_here

# Camera & Gateway Security
GATEWAY_SECRET_KEY=generate_strong_secret_for_local_attendance_gateways
ENCRYPTION_KEY=32_byte_hex_key_for_encrypting_camera_credentials_in_db

# Audit & Retention Defaults (Days)
AUDIT_LOG_RETENTION_DAYS=365
SNAPSHOT_RETENTION_DAYS=30
